# Supabase / PostgreSQL connection string
# Local: conexión directa (puerto 5432)
# Vercel: usar Connection Pooler (puerto 6543) + ?pgbouncer=true - ver README
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Auth.js - string aleatorio de 32+ caracteres para firmar JWT
AUTH_SECRET="cambiar-por-string-aleatorio-seguro"
# Producción: NEXTAUTH_URL="https://www.lostordos.com"
