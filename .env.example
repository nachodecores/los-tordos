# Configurar para el proyecto Supabase elegido, sin compartir valores en el chat.
# No usar DATABASE_URL ni credenciales del tambo para este modulo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca usar prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SECRET_KEY=
# Origen exacto de esta aplicacion: localhost en desarrollo, HTTPS en produccion.
APP_URL=http://localhost:3000

# Mapas: proveedor intercambiable. No requieren claves con el valor predeterminado.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
